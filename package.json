{
  "name": "uws-discord",
  "version": "1.0.0",
  "private": true,
  "description": "Discord community bot and server-configuration toolkit for an international mental wellbeing & personal growth community.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx scripts/setup-server.ts",
    "setup:apply": "tsx scripts/setup-server.ts --apply",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-commands:global": "tsx src/deploy-commands.ts --global",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.1.0"
  }
}
