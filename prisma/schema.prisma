generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Staff-issued warnings. Reasons are staff-authored text, never raw member
// message content (see modules/moderation for the "don't log full message
// content by default" policy).
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String   @map("guild_id")
  userId      String   @map("user_id")
  moderatorId String   @map("moderator_id")
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([guildId, userId])
  @@map("warnings")
}

// Member-submitted reports via /report. Access-controlled: only posted to
// the staff-only #member-reports channel, and only readable from the DB via
// the moderation module. Open reports are never auto-purged; resolved/reviewed
// ones follow the same retention window as warnings.
model Report {
  id              Int       @id @default(autoincrement())
  guildId         String    @map("guild_id")
  reporterId      String    @map("reporter_id")
  reportedUserId  String?   @map("reported_user_id")
  context         String?
  reason          String
  status          String    @default("open") // "open" | "reviewed" | "resolved"
  createdAt       DateTime  @default(now()) @map("created_at")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")

  @@index([guildId, status])
  @@map("reports")
}

// Community events. `startsAt` is always stored as a real UTC instant — the
// wall-clock/timezone input from /event-create is converted to UTC before
// saving (see modules/events/timezone.ts). Display uses Discord's native
// <t:...> timestamp markup, which each viewer's client renders in their own
// local time automatically.
model Event {
  id              Int       @id @default(autoincrement())
  guildId         String    @map("guild_id")
  title           String
  description     String
  startsAt        DateTime  @map("starts_at")
  durationMinutes Int       @default(60) @map("duration_minutes")
  hostId          String    @map("host_id")
  proposedBy      String    @map("proposed_by")
  voiceChannelId  String?   @map("voice_channel_id")
  status          String    @default("pending") // pending | published | cancelled
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  discordEventId  String?   @map("discord_event_id")
  reminderSentAt  DateTime? @map("reminder_sent_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  rsvps    EventRsvp[]
  feedback EventFeedback[]

  @@index([guildId, status])
  @@map("events")
}

model EventRsvp {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  userId    String   @map("user_id")
  status    String   @default("going") // going | interested | cancelled
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

model EventFeedback {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  userId    String   @map("user_id")
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@map("event_feedback")
}

// Minimal engagement signal: a running count, not a transcript.
model MessageStat {
  guildId       String    @map("guild_id")
  userId        String    @map("user_id")
  messageCount  Int       @default(0) @map("message_count")
  lastMessageAt DateTime? @map("last_message_at")

  @@id([guildId, userId])
  @@map("message_stats")
}

// Tracks the last time each scheduled prompt type posted, so the periodic
// scheduler survives restarts without double-posting the same day/week.
model EngagementState {
  guildId      String   @map("guild_id")
  promptType   String   @map("prompt_type") // "daily" | "gratitude" | "weeklyChallenge"
  lastPostedAt DateTime @map("last_posted_at")

  @@id([guildId, promptType])
  @@map("engagement_state")
}

// Technical foundation for premium membership. `provider`/`externalSubscriptionId`
// stay null until a real payment processor is chosen and approved — for now,
// tier changes only ever come from an Administrator via /membership.
model Membership {
  id                     Int       @id @default(autoincrement())
  guildId                String    @map("guild_id")
  userId                 String    @map("user_id")
  tier                   String    @default("free") // "free" | "premium"
  status                 String    @default("active") // "active" | "cancelled" | "past_due"
  provider               String?
  externalSubscriptionId String?   @map("external_subscription_id")
  currentPeriodEnd       DateTime? @map("current_period_end")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([guildId, userId])
  @@map("memberships")
}

// Idempotency ledger for payment-provider webhooks: each provider event ID is
// recorded once, so a retried/duplicated webhook delivery can never apply the
// same subscription change twice. Unused until a real processor is wired in.
model ProcessedWebhookEvent {
  provider   String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@id([provider, eventId])
  @@map("processed_webhook_events")
}
