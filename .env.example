# Copy this file to .env and fill in real values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the "General Information" page of your application
DISCORD_CLIENT_ID=

# The ID of the Discord server (guild) this bot manages.
# Enable Developer Mode in Discord (Settings -> Advanced), then right-click the server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# Optional: restrict destructive slash commands to an extra hard-coded list of user IDs
# beyond role checks, as a safety net (comma-separated). Leave blank to rely on roles only.
BOT_OWNER_IDS=

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/uws-bot.sqlite
