# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the "General Information" page of your application
DISCORD_CLIENT_ID=

# The ID of the Discord server (guild) this bot manages.
# Enable Developer Mode in Discord (Settings -> Advanced), then right-click the server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# Postgres connection string. `docker compose up -d` starts a local Postgres matching this default.
DATABASE_URL=postgresql://uws:uws_dev_password@localhost:5432/uws_discord

# Working placeholder until the community's final name is confirmed.
COMMUNITY_NAME=COMMUNITY_NAME

# Keep false until a payment provider is chosen, approved, and its webhook verified.
PREMIUM_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Optional: restrict destructive slash commands to an extra hard-coded list of user IDs
# beyond role checks, as a safety net (comma-separated). Leave blank to rely on roles only.
BOT_OWNER_IDS=

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Days to keep resolved moderation records (warnings, reviewed/resolved reports) before auto-purge.
# Open reports are never auto-purged regardless of age.
MODERATION_LOG_RETENTION_DAYS=180

# Toggle scheduled engagement prompts independently, without touching code (restart to apply).
ENGAGEMENT_DAILY_PROMPT_ENABLED=true
ENGAGEMENT_GRATITUDE_PROMPT_ENABLED=true
ENGAGEMENT_WEEKLY_CHALLENGE_ENABLED=true
